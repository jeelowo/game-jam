[gd_resource type="Resource" script_class="Dialogue" format=3 uid="uid://cy1ge0cbbeau0"]

[ext_resource type="Script" uid="uid://c4sfujko7r1pq" path="res://Assets/Dialogue/dialogue_line.gd" id="1_qfr2b"]
[ext_resource type="Script" uid="uid://dwu0lv6rm63je" path="res://Assets/Dialogue/dialogue.gd" id="1_qisq5"]

[sub_resource type="Resource" id="Resource_qfr2b"]
script = ExtResource("1_qfr2b")
speaker = "❤️"
text = "Despite the world trying to erase you, your soul remembered how to continue."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_qisq5"]
script = ExtResource("1_qfr2b")
speaker = "💛"
text = "Despite having every reason to hate, you refused to become cruel."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_noiuf"]
script = ExtResource("1_qfr2b")
speaker = "💚"
text = "Despite being hurt over and over, you still spoke gently."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_b8f87"]
script = ExtResource("1_qfr2b")
speaker = "💙"
text = "Despite the pressure to change, you stayed true to yourself."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_lhfis"]
script = ExtResource("1_qfr2b")
speaker = "💜"
text = "Despite every ending telling you to stop, you kept walking."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_k0848"]
script = ExtResource("1_qfr2b")
speaker = "🧡"
text = "Despite the trembling in your hands, you still opened the door."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_o410u"]
script = ExtResource("1_qfr2b")
speaker = "*"
text = "and..."
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

[sub_resource type="Resource" id="Resource_c6iox"]
script = ExtResource("1_qfr2b")
speaker = "*"
text = "Despite everything, it's still you"
metadata/_custom_type_script = "uid://c4sfujko7r1pq"

